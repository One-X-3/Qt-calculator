  <property name="styleSheet">
   <string notr="true">/* =========================================
   全局基础设置（背景与默认字体）
========================================= */
QWidget {
    background-color: #f3f3f3; /* 浅灰背景，衬托按键 */
    /* 设置字体优先级：优先使用英文排版极佳的 Segoe UI，其次是微软雅黑 */
    font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;, &quot;PingFang SC&quot;, sans-serif;
}

/* =========================================
   顶部显示框 (display)
========================================= */
QLineEdit#display {
    background-color: transparent;
    border: none;
    color: #1a1a1a;           /* 深灰偏黑，比纯黑更柔和 */
    font-size: 46px;          /* 放大数字，更有视觉冲击力 */
    font-weight: 600;         /* 半粗体（比 bold 好看） */
    padding-right: 12px;
    padding-top: 20px;
    padding-bottom: 10px;
}

/* =========================================
   普通按钮（数字键、基本运算符）
========================================= */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;  /* 极浅的灰色边框 */
    border-radius: 12px;         /* 舒适的圆角 */
    color: #333333;
    font-size: 22px;            /* 放大按键文字 */
    font-weight: 500;           /* 中等字重 */
    margin: 4px;                /* 按键之间的缝隙 */
}

QPushButton:hover {
    background-color: #f7f7f7;  /* 鼠标悬停微亮 */
}

QPushButton:pressed {
    background-color: #e5e5e5;  /* 按下时变深 */
    padding-top: 2px;           /* 制造一点点按压下沉的错觉 */
    padding-left: 2px;
}

/* =========================================
   特殊功能按钮（C, CE, 退格, 正负号, 百分号）
   使用浅绿色底 + 深绿色字，与数字键区分
========================================= */
QPushButton#btnClear, 
QPushButton#btnClearEntry, 
QPushButton#btnBackspace,
QPushButton#btnNegate,
QPushButton#btnPercentage {
    background-color: #e8f8f0;  /* 极浅的薄荷绿 */
    color: #07C160;             /* 主色调绿 */
    font-weight: bold;          /* 加粗提醒这是功能键 */
}

QPushButton#btnClear:hover, 
QPushButton#btnClearEntry:hover, 
QPushButton#btnBackspace:hover,
QPushButton#btnNegate:hover,
QPushButton#btnPercentage:hover {
    background-color: #d1f2e1;
}

/* =========================================
   等号按钮 (核心重点！使用高级深绿色)
========================================= */
QPushButton#btnEqual {
    background-color: #07C160;  /* 高级绿色 */
    color: #ffffff;             /* 白字 */
    font-size: 26px;            /* 等号可以再大一点点 */
    font-weight: bold;
    border: none;
}

QPushButton#btnEqual:hover {
    background-color: #06ad56;  /* 悬停时略微变深 */
}

QPushButton#btnEqual:pressed {
    background-color: #059048;  /* 按下时更深 */
    padding-top: 3px;
    padding-left: 3px;
}

/* =========================================
   单目运算按钮 (1/x, x^2, √)
   让它们的颜色介于普通数字和清除键之间
========================================= */
QPushButton#btnReciprocal,
QPushButton#btnSquare,
QPushButton#btnSqrt {
    color: #07C160;
    background-color: #ffffff;
}

QPushButton#btnReciprocal:hover,
QPushButton#btnSquare:hover,
QPushButton#btnSqrt:hover {
    background-color: #f0fbf5; /* 悬停时透出一点绿意 */
}</string>
